# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=flexmobile_financing
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Payment Engine Configuration
PAYMENT_DUE_DAYS=30
WARNING_THRESHOLD_DAYS=5
ENFORCEMENT_THRESHOLD_DAYS=15

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@flexmobile.com

# Notification Service
NOTIFICATION_ENABLED=true
WARNING_EMAIL_TEMPLATE=payment_warning
ENFORCEMENT_EMAIL_TEMPLATE=device_restricted
UNLOCK_EMAIL_TEMPLATE=device_unlocked

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
